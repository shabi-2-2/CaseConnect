# CaseConnect - Supabase PostgreSQL Configuration
# Configure these variables in:
# 1. Local environment (.env.local - never committed)
# 2. Vercel Project Settings -> Environment Variables

# Supabase API URL (Required)
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Keys (At least one key required for server-side queries)
# Recommended for server-side API operations with administrative access:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public / Anon Key (Used as fallback or for public client operations):
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
